# Optional. Which port the app listens on, and the host port docker compose
# publishes it at — one variable drives both. Defaults to 3000.
# PORT=8080

# Optional. Where the SQLite file lives. Defaults to ./data/studio.db
# DATABASE_PATH=./data/studio.db

# docker compose only, and only for rootless Docker or Podman. Everywhere else
# the container works out for itself which uid owns ./data — see the comment on
# `user:` in docker-compose.yml. Under rootless it cannot start as root to do
# that, so pin it, and uncomment `user:` there as well:
#   printf 'DOCKER_UID=%s\nDOCKER_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
# DOCKER_UID=1000
# DOCKER_GID=1000

# ---------------------------------------------------------------- sign-in
# Set both and this install requires a login, with these credentials, from the
# first request — no dialog to click through, and nothing to lose when the data
# volume is recreated. Unset, there is no login at all and anyone who can reach
# the port can edit: that is the default, and it assumes a VPN.
#
# The username need not be an email — `admin` is fine. The password is taken
# exactly as written, spaces included, so quote it if it has any. It is never
# written to the database: rotating it is editing this file and restarting.
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-this-to-something-long

# Optional. How that account appears in the history. Defaults to the username.
# AUTH_NAME=Ops

# Setting the two above implies local accounts. Set this to override — `header`
# for a reverse proxy that already signs people in, `off` to force it open.
# AUTH_MODE=header

# Mark the session cookie `secure`. Set it once this is served over HTTPS; on
# plain HTTP the browser drops the cookie and signing in appears to do nothing.
# SECURE_COOKIES=1

# Document analysis is configured in the app — the gear in the sidebar — not
# here: provider, model, endpoint and key all live in the database.
#
# These variables are only a way to keep the key OUT of the data directory.
# When one is set and no key has been typed into the dialog, it is used, and
# the dialog says so. You still choose the provider and the model there.
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# NVIDIA_API_KEY=nvapi-...
# POOLSIDE_API_KEY=...
#
# The "OpenAI-compatible" provider has no key variable of its own: it is the row
# for a server you point at yourself, and it is the one provider that runs with
# no key at all.

# The two providers whose endpoint is yours to choose can also take it from here,
# with the same precedence: what is typed into the dialog wins, this fills in
# behind it. For an enterprise running its own inference instance that is the
# difference between a deployment that reproduces itself and one that needs the
# URL retyped on every fresh volume.
# POOLSIDE_BASE_URL=https://poolside.your-company.internal/v1
# OPENAI_COMPATIBLE_BASE_URL=http://vllm:8000/v1